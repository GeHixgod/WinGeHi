& {
  if (-not (Test-Path "$dir\undo.csv")) { Write-Warning "Не знайдено $dir\undo.csv"; return }
  $rows = Import-Csv "$dir\undo.csv" -Encoding UTF8
  "Рядків у журналі: $($rows.Count)"

  $bad = @($rows | Where-Object Type -eq 'reg' | Group-Object Target, Name | ForEach-Object { $_.Group[0] } | ForEach-Object {
    $cur = try { [string](Get-ItemProperty -LiteralPath $_.Target -Name $_.Name -ErrorAction Stop).($_.Name) } catch { '<absent>' }
    if ($cur -ne $_.Old) { [pscustomobject]@{ Ключ=$_.Target; Параметр=$_.Name; Було=$_.Old; Зараз=$cur } }
  })
  if ($bad) { $bad | Format-Table -AutoSize } else { 'Реєстр: усе повернулося' }

  'Служби:'
  $rows | Where-Object Type -eq 'service' | ForEach-Object {
    [pscustomobject]@{ Служба=$_.Target; Було=$_.Old; Зараз=(Get-Service $_.Target -ErrorAction SilentlyContinue).StartType }
  } | Format-Table -AutoSize

  'Завдання, очікую Ready:'
  $rows | Where-Object Type -eq 'task' | ForEach-Object { Get-ScheduledTask -TaskPath $_.Target -TaskName $_.Name | Select-Object TaskName,State } | Format-Table -AutoSize

  'Створені ключі, очікую False:'
  $rows | Where-Object Type -eq 'regkey' | ForEach-Object { "$($_.Target) існує: $(Test-Path -LiteralPath $_.Target)" }
}
